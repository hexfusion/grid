# Konflux build for the AI Grid data-plane gateway (RHOAI onboarding, RHOAIENG-95092).
# The single UBI build file for both ODH and RHOAI Konflux. FROM images pinned to
# @sha256 inline, which is the only form renovate's dockerfile manager tracks.
FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:866c52a4f649b2e027e0eafeede5f37dd13ac58ab63bbe2950d7928334312a4c AS build

# openssl-devel/pkgconf: praxis-proxy (Pingora) links OpenSSL. rust/cargo come as RPMs
# because rustup cannot be prefetched under hermetic mode. The prefetched repo exists
# only there, so a build without it uses the system repos.
RUN REPOS=/cachi2/output/deps/rpm/$(uname -m)/repos.d; \
    [ -d "$REPOS" ] && SETOPT="--setopt=reposdir=$REPOS" || SETOPT=""; \
    dnf install -y --nodocs --setopt=install_weak_deps=0 $SETOPT \
        gcc gcc-c++ make cmake openssl-devel pkgconf-pkg-config rust cargo \
    && dnf clean all

WORKDIR /src
COPY . .

# The gateway is its own workspace, and its prefetched .cargo/config.toml holds the git
# source replacement. Cargo finds that file from the working directory, not from
# --manifest-path, so the build has to run from here or the git dependency is unresolvable.
WORKDIR /src/gateway
# --locked: under prefetch a build free to re-resolve can drift from what was fetched.
# --ignore-rust-version: UBI ships 1.92, the manifests declare 1.96.
RUN cargo build --release --locked --ignore-rust-version --bin grid-gateway \
    && cp target/release/grid-gateway /usr/local/bin/grid-gateway

FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:d34666200b64d5a183c867487fd2f48ee8547eb18134e5647099970e26f08af9

COPY --from=build --chmod=0555 /usr/local/bin/grid-gateway /usr/local/bin/grid-gateway

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/grid-gateway"]

LABEL com.redhat.component="odh-praxis-ai-grid-gateway-container" \
      name="odh-praxis-ai-grid-gateway-rhel9" \
      description="Praxis-based data-plane gateway for AI Grid" \
      summary="Praxis-based data-plane gateway for AI Grid" \
      io.k8s.display-name="odh-praxis-ai-grid-gateway" \
      io.k8s.description="odh-praxis-ai-grid-gateway"
