# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Stage 1: Build
# ------------------------------------------------------------------------------
#
# Copy workspace manifests first, build with stub sources to cache dependency
# compilation, then copy real source and rebuild only the overlay-sync binary.

FROM rust:1.96-alpine AS builder

ENV OPENSSL_STATIC=1

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf cmake make g++

WORKDIR /src

# ------------------------------------------------------------------------------
# Cache Build
# ------------------------------------------------------------------------------

COPY Cargo.toml Cargo.lock ./
COPY overlay-sync/Cargo.toml overlay-sync/Cargo.toml

# Strip workspace members not needed for the overlay-sync binary.
RUN sed -i '/certs/d; /crdt/d; /forge/d; /mock-providers/d; /operator/d; /scoring/d; /swim/d; /xtask/d' Cargo.toml

RUN mkdir -p overlay-sync/src \
    && echo '//! stub' > overlay-sync/src/lib.rs \
    && printf '//! stub\nfn main() {}\n' > overlay-sync/src/main.rs

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p overlay-sync --bin overlay-sync

# ------------------------------------------------------------------------------
# Build
# ------------------------------------------------------------------------------

COPY overlay-sync/src overlay-sync/src

RUN find overlay-sync/src -name '*.rs' -exec touch {} +

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p overlay-sync --bin overlay-sync \
    && cp target/release/overlay-sync /usr/local/bin/overlay-sync

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.source="https://github.com/praxis-proxy/grid" \
    org.opencontainers.image.description="Grid routing overlay ConfigMap watcher" \
    org.opencontainers.image.licenses="MIT"

ARG KUBECTL_VERSION=1.32.0

RUN apk add --no-cache ca-certificates \
    && wget -q "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
        -O /usr/local/bin/kubectl \
    && chmod 0555 /usr/local/bin/kubectl \
    && addgroup -S grid \
    && adduser -S -G grid -h /nonexistent -s /sbin/nologin grid

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/overlay-sync /usr/local/bin/overlay-sync

USER grid:grid

ENTRYPOINT ["overlay-sync"]
