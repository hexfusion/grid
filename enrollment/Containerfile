# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Stage 1: Build
# ------------------------------------------------------------------------------

FROM rust:1.96-alpine AS builder

ENV OPENSSL_STATIC=1

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf cmake make g++

WORKDIR /src

# ------------------------------------------------------------------------------
# Cache Build
# ------------------------------------------------------------------------------

COPY Cargo.toml Cargo.lock ./
COPY enrollment/Cargo.toml enrollment/Cargo.toml
COPY certs/Cargo.toml certs/Cargo.toml
COPY projection/Cargo.toml projection/Cargo.toml

# Strip workspace members this binary does not need. certs signs; projection is
# pulled in by gridctl, which this crate also builds.
RUN sed -i '/"crdt"/d; /"forge"/d; /"mock-providers"/d; /"operator"/d; /"overlay-sync"/d; /"scoring"/d; /"swim"/d; /"xtask"/d' Cargo.toml

RUN mkdir -p enrollment/src/bin certs/src projection/src \
    && printf '//! stub\nfn main() {}\n' > enrollment/src/main.rs \
    && printf '//! stub\nfn main() {}\n' > enrollment/src/bin/gridctl.rs \
    && printf '//! stub\n' > enrollment/src/lib.rs \
    && printf '//! stub\n' > certs/src/lib.rs \
    && printf '//! stub\n' > projection/src/lib.rs

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p enrollment || true

# ------------------------------------------------------------------------------
# Build
# ------------------------------------------------------------------------------

COPY certs/src certs/src
COPY enrollment/src enrollment/src
COPY projection/src projection/src
COPY enrollment/db enrollment/db

RUN find certs/src enrollment/src projection/src -name '*.rs' -exec touch {} +

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p enrollment --bin enrollment --bin gridctl \
    && cp target/release/enrollment /usr/local/bin/enrollment \
    && cp target/release/gridctl /usr/local/bin/gridctl

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.source="https://github.com/praxis-proxy/grid" \
    org.opencontainers.image.description="Grid enrollment service" \
    org.opencontainers.image.licenses="MIT"

RUN apk add --no-cache ca-certificates \
    && addgroup -S grid \
    && adduser -S -G grid -h /nonexistent -s /sbin/nologin grid

COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/enrollment /usr/local/bin/enrollment
# Shipped alongside so an operator can decide from inside the cluster.
COPY --from=builder --chown=root:root --chmod=0555 \
    /usr/local/bin/gridctl /usr/local/bin/gridctl

USER 100:101

EXPOSE 8080

ENTRYPOINT ["enrollment"]
